{
  "name": "p05-remote-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:downstream": "npm run build && node dist/test/downstream-smoke.js",
    "test:policy": "npm run build && node dist/test/policy-profiles.js",
    "test:exposure": "npm run build && node dist/test/profile-exposure.js",
    "test": "npm run test:policy && npm run test:exposure && npm run smoke:downstream",
    "verify": "npm run check && npm run build && npm run smoke:downstream && npm run test",
    "verify:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/index.js",
    "start:http": "npm run build && npx -y supergateway@4.0.0-rc.1 --stdio \"node --env-file-if-exists=.env dist/index.js\" --outputTransport streamableHttp --port 8765 --streamableHttpPath /mcp --healthEndpoint /healthz"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
