# P05 local policy
# Working tree for this project: F:\Project_Git\P05_Remote_Agent
REMOTE_AGENT_ALLOWED_ROOTS=F:\Project_Git
REMOTE_AGENT_DEFAULT_CWD=F:\Project_Git
REMOTE_AGENT_SHELL_TIMEOUT_MS=120000

# Tool exposure policy (see docs/architecture/TOOL-PROFILES.md)
# safe = read-only surface (default) | dev = adds fs_write/mcp read | full = adds execution
# An unknown value aborts startup; there is no silent fallback.
P05_TOOL_PROFILE=safe

# Local-only unlock flags. Each dangerous tool needs BOTH its profile and its flag.
# Leave them unset on any daemon that a remote client can reach.
# P05_ENABLE_FS_WRITE=1
# P05_ENABLE_SHELL=1
# P05_ENABLE_DOWNSTREAM_EXEC=1

# Downstream MATLAB MCP
MATLAB_MCP_ENABLED=true
MATLAB_MCP_COMMAND=D:\Tools\matlab-mcp-server\matlab-mcp-server-windows-x64.exe
MATLAB_MCP_ARGS_JSON=["--matlab-root=D:\\Program Files\\MATLAB\\R2024b","--matlab-session-mode=auto"]
MATLAB_MCP_CWD=F:\Project_Git
