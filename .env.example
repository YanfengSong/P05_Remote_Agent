# P05 local policy
# Copy to .env and fill in values for THIS machine.

# Outer host authorization perimeter. REQUIRED.
# Use one or more explicit roots separated by semicolons. Do not authorize an entire drive.
REMOTE_AGENT_ALLOWED_ROOTS=

# Backward-compatible default/platform cwd.
# Leave blank to use the first allowed root.
REMOTE_AGENT_DEFAULT_CWD=

# Optional logical workspace registry.
# When provided:
# - every root must be inside REMOTE_AGENT_ALLOWED_ROOTS;
# - exactly one workspace must use kind=platform-source;
# - optional "plugins" restricts application plugins for that workspace.
# Example:
# P05_WORKSPACES_JSON=[{"id":"p05","root":"C:\\Projects\\P05_Remote_Agent","kind":"platform-source","plugins":["matlab"]},{"id":"project-a","root":"C:\\Projects\\ProjectA","kind":"git-project","plugins":["matlab"]}]
P05_WORKSPACES_JSON=

# Optional initial workspace id. Defaults to the first registered workspace.
P05_ACTIVE_WORKSPACE_ID=

REMOTE_AGENT_SHELL_TIMEOUT_MS=90000

# Optional per-file size limits in bytes. The V2 ranged-read contract never reads more
# than 8 MiB per file and uses the smaller of this value and that hard cap. Invalid or
# non-positive values fail closed.
#REMOTE_AGENT_MAX_READ_BYTES=2097152
#REMOTE_AGENT_MAX_WRITE_BYTES=2097152

# P05 approval policy default:
# standard: CONFIRM operations require Operator approval.
# trusted: CONFIRM operations are allowed immediately; hard DENY guardrails remain.
# The Operator toggle persists a machine-local override under .p05/approval-mode.json
# and takes effect across Runtime A/B without editing this file.
P05_APPROVAL_MODE=standard

# Optional structured read-only SSH targets.
# remote_read never accepts arbitrary hosts, identity paths or command text from callers.
# Configure these locally to enable fixed H1/J1 maintenance reads.
#P05_REMOTE_READ_SSH_PATH=ssh.exe
#P05_REMOTE_READ_H1_HOST=<h1-host-or-ip>
#P05_REMOTE_READ_H1_USER=<h1-user>
#P05_REMOTE_READ_H1_IDENTITY=<absolute-local-path-to-h1-private-key>
# J1 is reached through H1 using the identity that already exists on H1.
#P05_REMOTE_READ_J1_HOST=<j1-host-or-ip>
#P05_REMOTE_READ_J1_USER=<j1-user>
#P05_REMOTE_READ_J1_IDENTITY_ON_H1=<absolute-posix-path-to-j1-private-key-on-h1>

# Tool exposure policy:
# discovery (default) | readonly | developer | full
P05_TOOL_PROFILE=discovery
# fs_read is legacy. Default tool surfaces expose fs_read_many instead (also for one path).
# Set to 1 only for older MCP clients that require fs_read's exact response schema.
#P05_EXPOSE_LEGACY_FS_READ=1

# P05 persistent state is repo-contained.
# If set explicitly, it MUST remain inside <repo>/.p05.
#P05_STATE_DIR=<repo>\.p05

# MATLAB application plugin / MathWorks Agentic Toolkit adapter.
MATLAB_MCP_ENABLED=false
# By default P05 discovers the repo-local toolkit:
# <repo>\.p05\tools\matlab\agentic-toolkits
# External toolkit roots are refused by the P05 containment guard.
#MATLAB_AGENTIC_TOOLKIT_ROOT=<repo>\.p05\tools\matlab\agentic-toolkits
#MATLAB_MCP_COMMAND=<repo>\.p05\tools\matlab\agentic-toolkits\bin\matlab-mcp-server.exe
#MATLAB_MCP_ARGS_JSON=["--matlab-root=<absolute MATLAB installation root>","--matlab-session-mode=auto"]
#MATLAB_MCP_AUTO_SIMULINK=true
# Long-running MATLAB/Simulink operations default to 10 minutes.
#MATLAB_MCP_TIMEOUT_MS=600000

# active (default): bind MATLAB child process to the current business workspace
# platform: bind to the P05 platform-source workspace
# fixed: bind to MATLAB_MCP_CWD
#MATLAB_MCP_WORKSPACE_BINDING=active
#MATLAB_MCP_CWD=<required only for fixed binding>


# Repo-local Operator Console / runtime topology.
# Fresh bootstrap defaults to one Runtime (A). Use A,B for dual-runtime mode.
P05_OPERATOR_PORT=56301
P05_RUNTIME_SLOTS=A
P05_RUNTIME_A_PROFILE=p05-a
P05_RUNTIME_B_PROFILE=p05-b
# Operator display names for the connectors associated with each Runtime slot.
# Set these to the actual ChatGPT connector names for this machine.
P05_RUNTIME_A_CONNECTOR=@Runtime-A
P05_RUNTIME_B_CONNECTOR=@Runtime-B
P05_TUNNEL_A_ID=
P05_TUNNEL_B_ID=

# Optional native HTTP Reviewer (readonly Streamable HTTP MCP).
# It is an independent sidecar process; Runtime A/B do not start it automatically.
# Start manually with: npm run start:http-reviewer
#
# Reviewer follows exactly one Runtime slot. Defaults: Slot B, loopback port 8765.
#P05_HTTP_REVIEWER_SLOT=B
#P05_HTTP_REVIEWER_PORT=8765
#
# Optional private state override. When omitted:
# <repo>/.p05/runtime-<slot>/state
#P05_HTTP_REVIEWER_STATE_DIR=<repo>\.p05\runtime-<slot>\state
#
# Optional public base URL used when the Reviewer is exposed through a reverse proxy/tunnel.
# Leave unset for local/forwarded-host discovery.
#P05_HTTP_REVIEWER_PUBLIC_BASE_URL=https://reviewer.example.com
#
# Optional static bearer token. Leave unset to generate/persist a private token automatically.
# Never commit a real token to Git.
#P05_HTTP_REVIEWER_TOKEN=
#
# Optional fixed OAuth client. ID and secret MUST be supplied together.
# Leave both unset to use/generate the private client file under the Reviewer state directory.
# Never commit a real client secret to Git.
#P05_HTTP_REVIEWER_OAUTH_CLIENT_ID=p05-gemini-reviewer
#P05_HTTP_REVIEWER_OAUTH_CLIENT_SECRET=

# bootstrap.ps1 installs managed executables and caches under <repo>/.p05 and writes
# their absolute paths to .env. They are Git-ignored machine-local artifacts.
#P05_NODE_PATH=<repo>\.p05\tools\node\node.exe
#P05_OPERATOR_TUNNEL_CLIENT=<repo>\.p05\tools\tunnel-client\tunnel-client.exe
#NPM_CONFIG_CACHE=<repo>\.p05\npm-cache

# The control-plane key is stored only in the Git-ignored .env on fresh installs.
# Prefer the secure interactive bootstrap prompt rather than passing it on the command line.
#CONTROL_PLANE_API_KEY=

# Repo-local network selection for Bootstrap downloads and tunnel-client.
# auto: prefer direct when reachable, then probe detected proxies.
# direct: explicitly bypass proxies.
# proxy: require P05_PROXY and fail closed if it is unusable.
P05_NETWORK_MODE=auto
P05_PROXY=

# Bootstrap writes the selected path to these compatibility variables so npm and
# tunnel-client inherit the exact same proxy decision. Leave them managed by Bootstrap.
CONTROL_PLANE_HTTP_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
