# P05 local policy
# Copy to .env and fill in values for THIS machine.

# Outer host authorization perimeter. REQUIRED.
# Use one or more explicit roots separated by semicolons. Do not authorize an entire drive.
REMOTE_AGENT_ALLOWED_ROOTS=

# Backward-compatible default/platform cwd.
# Leave blank to use the first allowed root.
REMOTE_AGENT_DEFAULT_CWD=

# Optional logical workspace registry.
# When provided:
# - every root must be inside REMOTE_AGENT_ALLOWED_ROOTS;
# - exactly one workspace must use kind=platform-source;
# - optional "plugins" restricts application plugins for that workspace.
# Example:
# P05_WORKSPACES_JSON=[{"id":"p05","root":"C:\\Projects\\P05_Remote_Agent","kind":"platform-source","plugins":["matlab"]},{"id":"project-a","root":"C:\\Projects\\ProjectA","kind":"git-project","plugins":["matlab"]}]
P05_WORKSPACES_JSON=

# Optional initial workspace id. Defaults to the first registered workspace.
P05_ACTIVE_WORKSPACE_ID=

REMOTE_AGENT_SHELL_TIMEOUT_MS=120000

# Tool exposure policy:
# discovery (default) | readonly | developer | full
P05_TOOL_PROFILE=discovery

# Optional P05 state directory.
# Device identity and persistent audit/recovery metadata live here.
# When omitted, P05 anchors state to <repo>/.p05 independent of process cwd.
#P05_STATE_DIR=<absolute private state directory>

# MATLAB application plugin / MathWorks Agentic Toolkit adapter.
MATLAB_MCP_ENABLED=false
# By default P05 discovers ~/.matlab/agentic-toolkits/bin/matlab-mcp-server and
# automatically loads simulink/tools/tools.json when present.
#MATLAB_AGENTIC_TOOLKIT_ROOT=<optional custom agentic-toolkits root>
#MATLAB_MCP_COMMAND=<optional explicit matlab-mcp-server override>
#MATLAB_MCP_ARGS_JSON=["--matlab-root=<absolute MATLAB installation root>","--matlab-session-mode=auto"]
#MATLAB_MCP_AUTO_SIMULINK=true
# Long-running MATLAB/Simulink operations default to 10 minutes.
#MATLAB_MCP_TIMEOUT_MS=600000

# active (default): bind MATLAB child process to the current business workspace
# platform: bind to the P05 platform-source workspace
# fixed: bind to MATLAB_MCP_CWD
#MATLAB_MCP_WORKSPACE_BINDING=active
#MATLAB_MCP_CWD=<required only for fixed binding>


# Repo-local Operator Console / runtime topology.
# Fresh bootstrap defaults to one Runtime (A). Use A,B for dual-runtime mode.
P05_OPERATOR_PORT=56301
P05_RUNTIME_SLOTS=A
P05_RUNTIME_A_PROFILE=p05-a
P05_RUNTIME_B_PROFILE=p05-b
P05_TUNNEL_A_ID=
P05_TUNNEL_B_ID=

# bootstrap.ps1 installs both executables under <repo>/.p05/tools and writes
# their absolute paths to .env. They are Git-ignored machine-local artifacts.
#P05_NODE_PATH=<repo>\.p05\tools\node\node.exe
#P05_OPERATOR_TUNNEL_CLIENT=<repo>\.p05\tools\tunnel-client\tunnel-client.exe

# The control-plane key is stored only in the Git-ignored .env on fresh installs.
# Prefer the secure interactive bootstrap prompt rather than passing it on the command line.
#CONTROL_PLANE_API_KEY=

# Repo-local network selection for Bootstrap downloads and tunnel-client.
# auto: prefer direct when reachable, then probe detected proxies.
# direct: explicitly bypass proxies.
# proxy: require P05_PROXY and fail closed if it is unusable.
P05_NETWORK_MODE=auto
P05_PROXY=

# Bootstrap writes the selected path to these compatibility variables so npm and
# tunnel-client inherit the exact same proxy decision. Leave them managed by Bootstrap.
CONTROL_PLANE_HTTP_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
