# P05 local policy
# Copy to .env and fill in values for THIS machine.

# Outer host authorization perimeter. REQUIRED.
# Use one or more explicit roots separated by semicolons. Do not authorize an entire drive.
REMOTE_AGENT_ALLOWED_ROOTS=

# Backward-compatible default/platform cwd.
# Leave blank to use the first allowed root.
REMOTE_AGENT_DEFAULT_CWD=

# Optional logical workspace registry.
# When provided:
# - every root must be inside REMOTE_AGENT_ALLOWED_ROOTS;
# - exactly one workspace must use kind=platform-source;
# - optional "plugins" restricts application plugins for that workspace.
# Example:
# P05_WORKSPACES_JSON=[{"id":"p05","root":"C:\\Projects\\P05_Remote_Agent","kind":"platform-source","plugins":["matlab"]},{"id":"project-a","root":"C:\\Projects\\ProjectA","kind":"git-project","plugins":["matlab"]}]
P05_WORKSPACES_JSON=

# Optional initial workspace id. Defaults to the first registered workspace.
P05_ACTIVE_WORKSPACE_ID=

REMOTE_AGENT_SHELL_TIMEOUT_MS=120000

# Tool exposure policy:
# discovery (default) | readonly | developer | full
P05_TOOL_PROFILE=discovery

# Optional P05 state directory.
# Device identity and persistent audit/recovery metadata live here.
# When omitted, P05 anchors state to <repo>/.p05 independent of process cwd.
#P05_STATE_DIR=<absolute private state directory>

# MATLAB application plugin / downstream MCP.
MATLAB_MCP_ENABLED=false
#MATLAB_MCP_COMMAND=<absolute path to matlab-mcp-server executable>
#MATLAB_MCP_ARGS_JSON=["--matlab-root=<absolute MATLAB installation root>","--matlab-session-mode=auto"]

# active (default): bind MATLAB child process to the current business workspace
# platform: bind to the P05 platform-source workspace
# fixed: bind to MATLAB_MCP_CWD
#MATLAB_MCP_WORKSPACE_BINDING=active
#MATLAB_MCP_CWD=<required only for fixed binding>


# Optional local Operator Console configuration.
# The Console binds only to 127.0.0.1.
P05_OPERATOR_PORT=56301
P05_OPERATOR_RUNTIME_TASK=P05-Runtime
P05_OPERATOR_RESTART_TASK=P05-RestartBroker
P05_OPERATOR_TUNNEL_ALIAS=

# Optional machine-local executable overrides used by deployment/Operator Console.
# Prefer leaving these blank when node/tunnel-client are already on PATH.
#P05_NODE_PATH=<absolute path to node.exe>
#P05_OPERATOR_TUNNEL_CLIENT=<absolute path to tunnel-client.exe>

# Scheduled Task names used by the Operator Console and deployment scripts.
P05_OPERATOR_TASK=P05-Operator

# Optional machine-local network proxy settings for tunnel-client/control-plane access.
# Keep these blank on machines that do not require a proxy.
#CONTROL_PLANE_HTTP_PROXY=http://127.0.0.1:7892
#HTTPS_PROXY=http://127.0.0.1:7892
#HTTP_PROXY=http://127.0.0.1:7892
