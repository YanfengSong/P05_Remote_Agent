# P05 local policy
# Copy to .env and fill in the values for THIS machine.
# Nothing here has a machine-specific default: every path below is stated explicitly, so
# this file is safe to publish and portable between machines.
#
# Absolute root(s) this agent may touch, semicolon-separated.
# REQUIRED - there is no built-in root: an unset value aborts startup, an explicitly empty
# value aborts startup, and a relative path is rejected (it would resolve against the
# working directory).
# Do not point this at a whole drive such as C:\ or D:\.
REMOTE_AGENT_ALLOWED_ROOTS=

# Working directory for shell/process tools. When set, it must be an absolute path inside
# an allowed root; a value outside the roots aborts startup.
# Leave blank (or omit it) to use the first allowed root - this is the documented default.
REMOTE_AGENT_DEFAULT_CWD=

REMOTE_AGENT_SHELL_TIMEOUT_MS=120000

# Tool exposure policy (see docs/architecture/TOOL-PROFILES.md)
# discovery (default) | readonly | developer | full
# An unknown value aborts startup instead of falling back; full must never be the default.
P05_TOOL_PROFILE=discovery

# Downstream MATLAB MCP - optional and per machine; there is no default command or root.
# Leave disabled unless MATLAB and the MATLAB MCP server are installed here.
MATLAB_MCP_ENABLED=false
#MATLAB_MCP_COMMAND=<absolute path to the matlab-mcp-server executable>
#MATLAB_MCP_ARGS_JSON=["--matlab-root=<absolute MATLAB installation root>","--matlab-session-mode=auto"]
#MATLAB_MCP_CWD=<absolute working directory, must be inside an allowed root>
