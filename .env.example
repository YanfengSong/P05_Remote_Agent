# P05 local policy
# Copy to .env and fill in the values for THIS machine.
#
# Absolute root(s) this agent may touch, semicolon-separated.
# MUST be filled: an explicitly empty value aborts startup instead of falling back,
# and a relative path is rejected (it would resolve against the working directory).
# Do not point this at a whole drive such as C:\ or F:\.
REMOTE_AGENT_ALLOWED_ROOTS=

# Working directory for shell/process tools. Must be inside an allowed root.
# Leave empty to use the first allowed root.
REMOTE_AGENT_DEFAULT_CWD=

REMOTE_AGENT_SHELL_TIMEOUT_MS=120000

# Tool exposure policy (see docs/architecture/TOOL-PROFILES.md)
# discovery (default) | readonly | developer | full
# An unknown value aborts startup instead of falling back; full must never be the default.
P05_TOOL_PROFILE=discovery

# Downstream MATLAB MCP
# Binary lives on D: on this machine; adjust for the target machine.
MATLAB_MCP_ENABLED=true
MATLAB_MCP_COMMAND=D:\Tools\matlab-mcp-server\matlab-mcp-server-windows-x64.exe
MATLAB_MCP_ARGS_JSON=["--matlab-root=D:\\Program Files\\MATLAB\\R2024b","--matlab-session-mode=auto"]
MATLAB_MCP_CWD=
